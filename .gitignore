# Entornos virtuales de Python
.venv/
.venv312/
venv/
env/

# Cache y compilados de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Videos: pesan cientos de megabytes y no pertenecen al repositorio
*.mp4
*.avi
*.mov
*.mkv

# Salidas generadas por los scripts
out/
out_v2/
output/
informe/
prueba_lote/
resultado/
resultado_v2/
resultado_v3/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Recortes generados por las corridas de validacion: pesan decenas de MB y se
# regeneran con los scripts. Los JSON y Excel de esas corridas si se conservan,
# porque son la evidencia que citan los informes.
validacion/**/*.jpg
validacion/**/coverage*.data
